# see https://wiki.debian.org/CrossToolchains
deb http://deb.debian.org/debian bookworm main
# Keep security updates for native amd64/i386 packages, but not foreign targets.
# Debian can publish Multi-Arch: same updates for native architectures first; the
# cross-architecture images pin affected native libraries to bookworm/main before
# adding their target architecture so package versions stay compatible.
deb [arch=amd64,i386] http://deb.debian.org/debian-security/ bookworm-security main
