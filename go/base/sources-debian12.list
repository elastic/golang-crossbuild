# see https://wiki.debian.org/CrossToolchains
deb http://deb.debian.org/debian bookworm main
# Keep security updates for native amd64/i386 packages, but not armhf. Debian can
# publish Multi-Arch: same updates for amd64 before armhf; the base image pins the
# affected native libraries to bookworm/main so their versions stay compatible.
deb [arch=amd64,i386] http://deb.debian.org/debian-security/ bookworm-security main
