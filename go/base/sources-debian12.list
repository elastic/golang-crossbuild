# see https://wiki.debian.org/CrossToolchains
deb http://deb.debian.org/debian bookworm main
# Security updates are available for amd64, i386, and armhf. armel is excluded
# because its package versions can lag; other cross-architecture images pin
# affected native libraries to bookworm/main before adding their target architecture.
deb [arch=amd64,i386,armhf] http://deb.debian.org/debian-security/ bookworm-security main
